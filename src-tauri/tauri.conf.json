{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drift",
  "version": "0.1.1",
  "identifier": "com.hutsonlabs.drift",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "bun run build", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "connections",
        "create": false,
        "title": "Connections",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "windowEffects": { "effects": ["sidebar"], "state": "active" }
      },
      {
        "label": "session",
        "create": false,
        "title": "Drift",
        "url": "session.html",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "windowEffects": { "effects": ["sidebar"], "state": "active" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "RDP client for GNOME Remote Desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "27.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "FE9B9ADD91CB67176BFE80FF725F77539D75BD96"
    }
  }
}
